name: Build LexzEngine APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v3
    - uses: actions/setup-java@v3
      with:
        java-version: '17'
        distribution: 'temurin'
    - uses: android-actions/setup-android@v2
    - run: |
        mkdir -p app/src/main/java/com/lexz/engine
        mkdir -p app/src/main/res/values
        mkdir -p app/src/main/res/xml
        mkdir -p app/src/main/assets
        
        echo "sdk.dir=$ANDROID_HOME" > local.properties
        
        aapt package -f -m -J app/src/main/java -M app/src/main/AndroidManifest.xml -S app/src/main/res -I $ANDROID_HOME/platforms/android-33/android.jar
        javac -source 1.8 -target 1.8 -cp $ANDROID_HOME/platforms/android-33/android.jar -d app/build/classes app/src/main/java/com/lexz/engine/*.java
        d8 --lib $ANDROID_HOME/platforms/android-33/android.jar --output app/build/ app/build/classes/com/lexz/engine/*.class
        aapt package -f -M app/src/main/AndroidManifest.xml -S app/src/main/res -A app/src/main/assets -I $ANDROID_HOME/platforms/android-33/android.jar -F app/build/app.unsigned.apk app/build/
        
        cd app/build && zip -uj app.unsigned.apk classes.dex && cd ../..
        zipalign -p -f 4 app/build/app.unsigned.apk app/build/app.aligned.apk
        
        keytool -genkey -v -keystore debug.keystore -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Android Debug,O=Android,C=US"
        apksigner sign --ks debug.keystore --ks-pass pass:android --key-pass pass:android --out LexzEngine.apk app/build/app.aligned.apk
    - uses: actions/upload-artifact@v3
      with:
        name: LexzEngine-APK
        path: LexzEngine.apk